# ===================================================================
# FILE NÀY DO ANSIBLE SINH RA — ĐỪNG SỬA TRỰC TIẾP TRÊN SERVER
# Sửa ở: ansible/templates/env.j2 rồi chạy lại playbook
# ===================================================================
# Cho máy: {{ inventory_hostname }}
#
# ===== VÌ SAO KHÔNG GHI THỜI GIAN SINH FILE Ở ĐÂY? =====
# Viết thêm một dòng như:
#     # Sinh lúc: {{ '{{' }} ansible_date_time.iso8601 {{ '}}' }}
# trông có vẻ hữu ích, nhưng nó PHÁ VỠ TÍNH IDEMPOTENT.
#
# (Chú ý: ngay dòng ví dụ trên cũng phải "escape" bằng {{ '{{' }}...
#  Nếu viết dấu ngoặc kép trực tiếp, Jinja2 sẽ render nó thành thời gian thật
#  và chính file này lại mất tính idempotent — đúng cái lỗi đang nói tới.)
#
# Lý do: thời gian đổi mỗi lần chạy -> nội dung file luôn khác bản cũ
# -> Ansible luôn báo "changed" -> handler luôn chạy -> app BỊ RESTART
# mỗi lần chạy playbook, dù chẳng có gì thay đổi thật.
#
# Đây là cái bẫy rất dễ mắc. Nguyên tắc: nội dung template chỉ được
# phụ thuộc vào BIẾN, không phụ thuộc vào THỜI ĐIỂM chạy.
#
# So sánh với .env.example viết tay: các giá trị dưới đây là BIẾN,
# nên cùng một template sinh ra config khác nhau cho staging và production.

# ===== Database =====
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_DB={{ postgres_db }}

# ===== Cổng mở ra ngoài =====
WEB_PORT={{ web_port }}
DB_PORT={{ db_port }}

# ===== Image sẽ chạy =====
# docker-compose.prod.yml đọc biến này để biết kéo image nào.
# Truyền từ dòng lệnh:  -e image_tag=ghcr.io/user/app:abc1234
IMAGE_TAG={{ image_tag }}
